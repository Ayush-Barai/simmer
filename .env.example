# Copy this file to .env and fill in your keys. Never commit .env.

# Open-weight Gemma via Google AI Studio (https://aistudio.google.com/apikey)
# Run "npm run models" to list the Gemma models your key can use.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# MongoDB Atlas free M0 connection string
MONGODB_URI=
MONGODB_DB=simmer

# ElevenLabs (https://elevenlabs.io) - optional, voice falls back to the browser
# On a free plan use a voice from your own account's "My Voices" (library voices
# return 402). Leave the id blank to let Simmer pick a usable voice automatically.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Live hands-free agent (ElevenLabs Conversational AI). Needs a key with the
# "Conversational AI" permission; Simmer can auto-create an agent if left blank.
ELEVENLABS_AGENT_ID=

# Subtitle languages to prefer when reading YouTube recipes (needs yt-dlp installed)
YT_SUB_LANGS=en.*,en

# Clerk auth (https://dashboard.clerk.com -> API keys)
# Publishable key (pk_...) is safe for the browser; secret key (sk_...) stays on the server.
# Leave both blank to keep the cookbook in guest mode.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sentry (https://sentry.io) - optional, enables agent tracing
SENTRY_DSN=

# Server port
PORT=3000
